# Public domain for Caddy TLS
DJUTIL_DOMAIN=djutil.example.com

# Argon2 hash for the web login. Generate with:
#   python -m djutil_server hash-password
DJUTIL_ADMIN_PASSWORD_HASH=

# Bearer token the agent uses for /api/sync/*
DJUTIL_AGENT_TOKEN=

# Secret for signing session cookies (any long random string)
DJUTIL_SESSION_SECRET=

# Set to "false" only for plain-HTTP local testing
DJUTIL_COOKIE_SECURE=true

# IANA time zone used for auto-generated set names ("Set 2026-10-04 17:16").
# Use your local zone so names match the wall clock shown in the UI.
DJUTIL_TZ=Europe/Berlin

# Optional override (defaults shown)
# DJUTIL_DATA_DIR=/data
# DJUTIL_STATIC_DIR=/app/static
